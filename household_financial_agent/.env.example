# Required: your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional model routing (sensible defaults if left unset):
#   COACH_MODEL      — the conversation/coaching model (needs judgment).
#   CLASSIFIER_MODEL — the cheap model classify.py uses for bulk tagging.
# To cut cost, set COACH_MODEL=claude-sonnet-5
COACH_MODEL=claude-opus-4-8
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Plaid (unused while running on local CSV data; kept for later):
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ACCESS_TOKEN=
